# Copy to .env locally; never commit credentials or a private voice ID
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=
MINIMAX_ENDPOINT=https://api.minimax.io/v1/t2a_v2
MINIMAX_MODEL=speech-2.8-hd
# Optional existing Chromium executable; otherwise install with npx playwright install chromium
REMOTION_BROWSER_EXECUTABLE=
# Local FFmpeg / ffprobe binaries, required by delivery validation
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
